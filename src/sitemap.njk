---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}
{%- if p.url and p.url != "/sitemap.xml" and p.url != "/robots.txt" and not p.data.noindex and not p.data.eleventyExcludeFromCollections and (p.url != "/ampersand.html" or site.ampersand.listed) and not ("/admin" in p.url) %}
  <url><loc>{{ site.url }}{{ p.url | replace(".html", "") }}</loc>{% if p.url.indexOf("/insights/") == 0 or p.url.indexOf("/work/") == 0 %}<lastmod>{{ p.date | isoDate }}</lastmod>{% endif %}</url>
{%- endif %}
{%- endfor %}
</urlset>
