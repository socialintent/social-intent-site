<script>
(function () {
  var form = document.getElementById('readiness-quiz');
  if (!form) return;
  var bands = [
    { min: 14, key: "well-prepared", title: "You look well prepared", text: "An Impact Health Check would confirm it and show where a funder or examiner might push back, before the report is final." },
    { min: 8, key: "foundations", title: "The foundations are there", text: "The Impact Report Pack would turn what you have into a clear, honest achievements and impact section, and a plan to strengthen it." },
    { min: 0, key: "start-now", title: "Start now, while there is time", text: "A Health Check will show what you can already say and what to collect this year, so the next report has real evidence behind it." }
  ];
  function update() {
    var total = 0, answered = 0;
    for (var i = 1; i <= 10; i++) {
      var c = form.querySelector('input[name="q' + i + '"]:checked');
      if (c) { answered++; total += parseInt(c.value, 10); }
    }
    var res = document.getElementById('quiz-result'), prog = document.getElementById('quiz-progress');
    if (answered < 10) { res.hidden = true; prog.hidden = false; prog.textContent = answered + ' of 10 answered.'; return; }
    var b = bands.filter(function (x) { return total >= x.min; })[0];
    document.getElementById('quiz-total').textContent = total;
    document.getElementById('quiz-title').textContent = b.title;
    document.getElementById('quiz-text').textContent = b.text;
    document.getElementById('qc-score').value = total;
    document.getElementById('qc-band').value = b.key;
    prog.hidden = true; res.hidden = false;
  }
  form.addEventListener('change', update);

  var cap = document.getElementById('quiz-capture-form');
  if (cap) cap.addEventListener('submit', function (e) {
    e.preventDefault();
    var fd = new FormData(cap), parts = [];
    if (fd.get('company-website')) return;
    fd.forEach(function (v, k) { parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(v)); });
    document.getElementById('quiz-error').hidden = true;
    fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: parts.join('&') })
      .then(function (r) { if (!r.ok) throw new Error('bad'); cap.hidden = true; document.querySelector('.quiz-capture > p').hidden = true; document.getElementById('quiz-thanks').hidden = false; })
      .catch(function () { document.getElementById('quiz-error').hidden = false; });
  });
})();
</script>

